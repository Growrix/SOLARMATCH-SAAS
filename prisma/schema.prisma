// ============================================================================
// PRISMA SCHEMA FILE
// ============================================================================
// This file is the "blueprint" for your database structure.
// Think of it like an architect's drawing before building a house.
//
// What Prisma does with this file:
// 1. Generates TypeScript code so you can talk to your database easily
// 2. Creates SQL migration files (instructions to create tables)
// 3. Keeps your code and database in sync
//
// TEACHING NOTE: You never write SQL by hand with Prisma. You write this
// schema, and Prisma writes the SQL for you!
// ============================================================================

// ----------------------------------------------------------------------------
// DATABASE CONNECTION SETTINGS
// ----------------------------------------------------------------------------
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // TEACHING NOTE: env("DATABASE_URL") is for pooled connections (app runtime)
  // directUrl is for migrations (direct connection)
  // Both are set in your .env file as recommended by Supabase
}

// ----------------------------------------------------------------------------
// CODE GENERATION SETTINGS
// ----------------------------------------------------------------------------
generator client {
  provider = "prisma-client-js"
  // TEACHING NOTE: This tells Prisma to generate JavaScript/TypeScript code
  // After running "npx prisma generate", you can import { PrismaClient }
  // and use it to query your database with autocomplete!
}

// ============================================================================
// NEWSLETTER SUBSCRIBER MODEL
// ============================================================================
// This defines the structure of our "newsletter_subscribers" table
// Each model becomes a table in the database
// Each field becomes a column in that table
// ============================================================================

model NewsletterSubscriber {
  // PRIMARY KEY (Unique Identifier)
  // --------------------------------
  id String @id @default(cuid())
  // TEACHING NOTE: Every table needs a unique ID to identify each record
  // @id = This is the primary key
  // @default(cuid()) = Auto-generate a unique ID when creating new records
  // "cuid" = Collision-resistant Unique ID (better than random numbers)
  // Example: "clx1a2b3c4d5e6f7g8h9"
  
  // EMAIL ADDRESS (Main data we're collecting)
  // ------------------------------------------
  email String @unique
  // TEACHING NOTE: @unique prevents duplicate emails
  // If someone tries to subscribe twice, the database will reject it
  // This is enforced at the database level, not just in your code
  
  // SUBSCRIPTION DATE (When they joined)
  // ------------------------------------
  subscribedAt DateTime @default(now())
  // TEACHING NOTE: @default(now()) automatically sets to current date/time
  // You don't need to manually set this when creating a new subscriber
  // Example: "2025-10-11T14:30:00.000Z"
  
  // ACTIVE STATUS (Are they still subscribed?)
  // -------------------------------------------
  isActive Boolean @default(true)
  // TEACHING NOTE: @default(true) means new subscribers are active by default
  // We use Boolean (true/false) instead of deleting records
  // This is called "soft delete" - keeps data for analytics
  
  // UNSUBSCRIBE DATE (When they left, if they did)
  // -----------------------------------------------
  unsubscribedAt DateTime?
  // TEACHING NOTE: The "?" means this field is OPTIONAL (can be null/empty)
  // Only set this when someone unsubscribes
  // If isActive = true, this should be null
  // If isActive = false, this should have a date
  
  // TABLE NAME MAPPING
  // ------------------
  @@map("newsletter_subscribers")
  // TEACHING NOTE: By default, Prisma uses the model name as table name
  // @@map changes it to "newsletter_subscribers" (snake_case)
  // This is a common convention in databases (lowercase with underscores)
  // Without this, the table would be called "NewsletterSubscriber"
}

// ============================================================================
// WHAT HAPPENS NEXT?
// ============================================================================
// 1. Run: npx prisma migrate dev --name add_newsletter_subscribers
//    - This creates SQL migration files
//    - Creates the table in your database
//    - Generates TypeScript code
//
// 2. Run: npx prisma generate
//    - Regenerates TypeScript code if you only changed comments
//
// 3. Use in your code:
//    import { prisma } from '@/lib/prisma';
//    const subscriber = await prisma.newsletterSubscriber.create({
//      data: { email: 'user@example.com' }
//    });
//
// ============================================================================
// COMMON PRISMA FIELD TYPES
// ============================================================================
// String    → Text (emails, names, descriptions)
// Int       → Whole numbers (age, count, price in cents)
// Float     → Decimal numbers (ratings, percentages)
// Boolean   → True/False (isActive, hasAccess)
// DateTime  → Date and time (createdAt, publishedAt)
// Json      → JSON data (settings, metadata)
//
// ============================================================================
// COMMON PRISMA DECORATORS
// ============================================================================
// @id              → Primary key (unique identifier)
// @unique          → No duplicates allowed
// @default(value)  → Auto-set this value when creating new records
// @updatedAt       → Auto-update timestamp when record changes
// Field?           → Optional field (can be null)
//
// ============================================================================

// ============================================================================
// GUEST INSTANT QUOTE MODEL
// ============================================================================
// This stores all instant solar quote submissions from guests (non-registered users).
// Each quote captures user inputs, calculated results, and metadata for analytics.
// Admins can view quote trends, conversion rates, and popular configurations.
// ============================================================================

model GuestInstantQuote {
  // PRIMARY KEY (Unique Identifier)
  // --------------------------------
  id String @id @default(cuid())
  // Auto-generated unique ID for each quote
  
  // SESSION & TRACKING
  // ------------------
  sessionId String?
  // Browser session ID to track user journey (for analytics)
  // Optional because some users may have tracking disabled
  
  ipAddress String?
  // IP address for fraud detection and location analytics
  // Stored as string (e.g., "192.168.1.1")
  
  userAgent String?
  // Browser/device info for UX analytics
  
  // TIMESTAMPS
  // ----------
  createdAt DateTime @default(now())
  // When the quote was generated
  
  updatedAt DateTime @updatedAt
  // Auto-updates when record changes
  
  // PROPERTY TYPE
  // -------------
  quoteType String
  // "residential" or "commercial"
  // Determines which calculation logic was used
  
  // LOCATION DATA
  // -------------
  postcode String
  // 4-digit Australian postcode (e.g., "2000")
  
  location String
  // Suburb name (e.g., "Sydney")
  
  state String
  // Australian state code (NSW, VIC, QLD, etc.)
  
  // ENERGY USAGE
  // ------------
  electricityUsageType String
  // "monthly" or "quarterly"
  
  electricityValue Float
  // Usage amount (bill $ or kWh)
  
  // SYSTEM CONFIGURATION
  // --------------------
  roofType String
  // Metal, tile, colorbond, etc.
  
  budgetRange String
  // User's budget bracket
  
  panelOrientation String
  // north, northeast, east, etc.
  
  roofTilt String
  // flat, low, optimal, steep
  
  shadingLevel String
  // none, minimal, partial, moderate, heavy
  
  desiredOffset Int
  // Target % of electricity bill to offset (e.g., 100)
  
  usagePattern String?
  // daytime, evening, spread (residential only)
  
  // BATTERY OPTIONS
  // ---------------
  batteryIncluded Boolean @default(false)
  
  batteryCapacity String?
  // Battery size in kWh if included
  
  batteryBrand String?
  // Tesla, Enphase, etc.
  
  customBatteryCapacity String?
  // Custom battery capacity if user specified their own value
  
  backupCritical String?
  // Backup priority: essential, whole-home, etc.
  
  batteryUsage String?
  // self-consumption, backup, etc.
  
  includeVPP Boolean @default(false)
  // Virtual Power Plant participation
  
  // COMMERCIAL-SPECIFIC
  // -------------------
  peakDemand String?
  // Peak demand in kW (commercial only)
  
  isThreePhase Boolean @default(false)
  
  projectPriority String?
  // reduce_bills, sustainability, etc.
  
  // ADVANCED OPTIONS
  // ----------------
  retailer String?
  // Energy retailer name
  
  tariffPlan String?
  // Tariff structure (single, time-of-use, etc.)
  
  additionalArrays Json?
  // Complex roof layouts with multiple arrays (stored as JSON)
  
  customRetailRate String?
  // User-provided rate in cents/kWh
  
  customFeedInRate String?
  // User-provided feed-in tariff
  
  panelBrand String?
  // Preferred panel manufacturer
  
  includeOptimizers Boolean @default(false)
  
  includeMicroinverters Boolean @default(false)
  
  includeEVCharging Boolean @default(false)
  
  includeSmartHome Boolean @default(false)
  
  includeGridServices Boolean @default(false)
  
  hasExistingSystem Boolean @default(false)
  
  existingSystemSize String?
  
  systemSizeOverride String?
  // User-specified system size override
  
  // CALCULATED RESULTS (JSON)
  // --------------------------
  results Json
  // Stores the complete calculation output as JSON:
  // {
  //   systemSize: 6.6,
  //   annualProduction: 9500,
  //   annualSavings: 1250,
  //   currentAnnualBill: 1800,
  //   totalCost: 8500,
  //   federalRebate: 2100,
  //   batteryRebate: 0,
  //   stateRebate: 1400,
  //   finalPrice: 5000,
  //   simplePaybackYears: 4.0,
  //   disclaimers: [...]
  // }
  
  // ADMIN NOTES & FLAGS
  // -------------------
  adminNotes String?
  // Internal notes from admin review
  
  isConverted Boolean @default(false)
  // True if guest later signed up and created a quote request
  
  conversionDate DateTime?
  // When they converted (if applicable)
  
  // TABLE NAME MAPPING
  // ------------------
  @@map("guest_instant_quotes")
  
  // INDEXES FOR PERFORMANCE
  // -----------------------
  @@index([createdAt])
  // Fast filtering by date
  
  @@index([state])
  // Group quotes by state
  
  @@index([quoteType])
  // Filter residential vs commercial
  
  @@index([sessionId])
  // Track user journey
}

// ============================================================================
// WHAT THIS MODEL ENABLES
// ============================================================================
// 1. Admin Dashboard Metrics:
//    - Total quotes generated per day/week/month
//    - Popular system sizes and configurations
//    - Geographic distribution (state/postcode heatmaps)
//    - Conversion funnel (guests → signups → quote requests)
//
// 2. Marketing Insights:
//    - Peak usage times and user behavior
//    - Budget preferences and price sensitivity
//    - Feature adoption (battery, EV charging, etc.)
//
// 3. Product Improvements:
//    - Identify common user configurations
//    - A/B testing different pricing models
//    - Optimize calculator accuracy
//
// 4. User Journey:
//    - Link anonymous quotes to user accounts later (via sessionId)
//    - Pre-fill forms when guests sign up
//    - Track conversion from quote → signup → purchase
// ============================================================================
