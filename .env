# ========================================
# 🔐 ENVIRONMENT VARIABLES
# ========================================
# This file contains SECRET information for your app.
# ⚠️ NEVER commit this file to git! (It's in .gitignore)
#
# What is this file for?
# - Stores passwords, API keys, and connection strings
# - Keeps secrets separate from your code
# - Different values for development vs production
#
# How to use:
# - Your code reads these values using process.env.VARIABLE_NAME
# - Example: process.env.DATABASE_URL
# ========================================

# ========================================
# 📊 DATABASE CONNECTION
# ========================================
# This tells Prisma how to connect to your PostgreSQL database.
#
# ⚠️ TODO: Replace this with YOUR actual Supabase connection string!
#
# How to get your Supabase connection string:
# 1. Go to https://supabase.com
# 2. Open your project (or create a new one)
# 3. Click "Settings" (gear icon) in the left sidebar
# 4. Click "Database"
# 5. Scroll to "Connection string" section
# 6. Copy the "URI" format (NOT the Session Pooler)
# 7. Replace [YOUR-PASSWORD] with your actual database password
#    (You set this when you created the Supabase project)
#
# Format explanation:
# postgresql:// - Database type (PostgreSQL)
# postgres - Username
# [YOUR-PASSWORD] - Your database password (replace this!)
# db.xxxxx.supabase.co - Your Supabase database host
# 5432 - Port number (default for PostgreSQL)
# postgres - Database name
#
# Example (FAKE - replace with yours):
# DATABASE_URL="postgresql://postgres:MySecretPassword123@db.abc123xyz.supabase.co:5432/postgres"
#
DATABASE_URL="postgresql://postgres:solarmatchdev@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:solarmatchdev@localhost:5432/postgres"


# ========================================
# 🔄 AFTER YOU UPDATE DATABASE_URL:
# ========================================
# 1. Save this file
# 2. Run: npx prisma generate
# 3. Run: npx prisma migrate dev --name add_newsletter_subscribers
# 4. Run: npm run dev
# 5. Test your newsletter form!
# ========================================

# ========================================
# 🔐 NEXTAUTH AUTHENTICATION
# ========================================
# Required for NextAuth.js to work
# NEXTAUTH_SECRET: Random string for JWT encryption (required!)
# NEXTAUTH_URL: Base URL of your app
# NEXTAUTH_DEBUG: Set to 'false' to disable debug warnings (default: enabled in dev)
# ========================================
NEXTAUTH_SECRET="solarmatch-dev-secret-key-change-in-production-2024"
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_DEBUG="false"  # Uncomment to disable debug warnings

# ========================================
# 🔐 OAUTH PROVIDERS (Optional)
# ========================================
# Google OAuth (for "Sign in with Google")
# Leave empty if not using Google sign-in
# ========================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ========================================
# �🚀 FUTURE VARIABLES (for later)
# ========================================
# When you add more features, you'll add more variables here.
# Examples:
#
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# OPENAI_API_KEY="sk-..."
# SENDGRID_API_KEY="SG...."
# STRIPE_SECRET_KEY="sk_test_..."
# ========================================
