# ========================================
# 🔐 ENVIRONMENT VARIABLES
# ========================================
# This file contains SECRET information for your app.
# ⚠️ NEVER commit this file to git! (It's in .gitignore)
#
# What is this file for?
# - Stores passwords, API keys, and connection strings
# - Keeps secrets separate from your code
# - Different values for development vs production
#
# How to use:
# - Your code reads these values using process.env.VARIABLE_NAME
# - Example: process.env.DATABASE_URL
# ========================================

# ========================================
# 📊 DATABASE CONNECTION
# ========================================
# This tells Prisma how to connect to your PostgreSQL database.
#
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solarmatch?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/solarmatch?schema=public"


# ========================================
# 🔄 AFTER YOU UPDATE DATABASE_URL:
# ========================================
# 1. Save this file
# 2. Run: npx prisma generate
# 3. Run: npx prisma migrate dev --name add_newsletter_subscribers
# 4. Run: npm run dev
# 5. Test your newsletter form!
# ========================================

# ========================================
# 🔐 NEXTAUTH AUTHENTICATION
# ========================================
# Required for NextAuth.js to work
# NEXTAUTH_SECRET: Random string for JWT encryption (required!)
# NEXTAUTH_URL: Base URL of your app
# NEXTAUTH_DEBUG: Set to 'false' to disable debug warnings (default: enabled in dev)
# ========================================
NEXTAUTH_SECRET="solarmatch-dev-secret-key-change-in-production-2024"
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_DEBUG="false"  # Uncomment to disable debug warnings

# ========================================
# 🔐 OAUTH PROVIDERS (Optional)
# ========================================
# Google OAuth (for "Sign in with Google")
# Leave empty if not using Google sign-in
# ========================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ========================================
# � TWILIO (Phone Verification via OTP)
# ========================================
# Used for sending OTP codes for homeowner/installer verification
# How to get credentials:
# 1. Sign up at https://www.twilio.com
# 2. Go to Console Dashboard
# 3. Copy Account SID and Auth Token
# 4. Create a Verify Service: Console → Verify → Services → Create new
# 5. Copy the Verify Service SID
# ========================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# ========================================
# 📧 SENDGRID (Email Notifications)
# ========================================
# Used for sending email notifications to users
# How to get API key:
# 1. Sign up at https://sendgrid.com
# 2. Go to Settings → API Keys
# 3. Click "Create API Key"
# 4. Give it "Full Access" permissions
# 5. Copy the API key
# ========================================
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@solarmatch.com"

# ========================================
# 💬 PUSHER (Real-time Chat & Notifications)
# ========================================
# Used for real-time messaging and live updates
# How to get credentials:
# 1. Sign up at https://pusher.com
# 2. Create a new Channels app
# 3. Go to App Keys tab
# 4. Copy app_id, key, secret, and cluster
# ========================================
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# ========================================
# 💳 STRIPE (Payment Processing)
# ========================================
# Used for processing lead purchases by installers
# How to get credentials:
# 1. Sign up at https://stripe.com
# 2. Go to Developers → API keys
# 3. Copy Publishable key (starts with pk_test_)
# 4. Copy Secret key (starts with sk_test_)
# 5. For webhooks: Developers → Webhooks → Add endpoint
#    URL: https://yourdomain.com/api/webhooks/stripe
#    Events: payment_intent.succeeded, payment_intent.payment_failed
# 6. Copy the webhook signing secret (starts with whsec_)
# ========================================
# 🔴 DEVELOPMENT MODE: Set to "true" to bypass Stripe payment processing
#    This allows testing purchase flow without real Stripe API keys
#    ⚠️ MUST be set to "false" in production!
STRIPE_BYPASS_MODE="true"

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ========================================
# ☁️ AWS S3 (Document Storage)
# ========================================
# Used for storing installer verification documents and quote attachments
# How to get credentials:
# 1. Sign up at https://aws.amazon.com
# 2. Go to IAM → Users → Create user
# 3. Attach policy: AmazonS3FullAccess (or create custom policy)
# 4. Go to Security credentials → Create access key
# 5. Copy Access Key ID and Secret Access Key
# 6. Create S3 bucket: S3 → Create bucket
# 7. Set bucket name and region
# ========================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="solarmatch-documents"

# ========================================
# 🎨 CHROMATIC (Visual Regression Testing)
# ========================================
# Used for Storybook visual regression testing
# How to get project token:
# 1. Sign up at https://www.chromatic.com
# 2. Create a new project
# 3. Copy the project token from setup page
# ========================================
CHROMATIC_PROJECT_TOKEN="chpt_3e534ce0fa63828"

# ========================================
# 🚀 FUTURE VARIABLES (for later)
# ========================================
# When you add more features, you'll add more variables here.
# Examples:
#
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# OPENAI_API_KEY="sk-..."
# ========================================
